# SpectraCanvas Environment Variables
# Copy this file to .env.local and fill in your actual values
# NEVER commit .env.local to Git!

# ============================================
# IBM watsonx API Configuration
# ============================================
# Get your API key from: https://cloud.ibm.com/iam/apikeys
WATSONX_API_KEY=your_watsonx_api_key_here

# Get your project ID from IBM watsonx.ai project settings
WATSONX_PROJECT_ID=your_watsonx_project_id_here

# IBM watsonx API endpoint (default: US South region)
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# ============================================
# Application Configuration (Optional)
# ============================================
# Public URL of your deployed application
# NEXT_PUBLIC_APP_URL=https://yourdomain.com

# Node environment (automatically set by Next.js)
# NODE_ENV=development

# ============================================
# GitHub Token (Optional - Only for CI/CD)
# ============================================
# NEVER use your personal token here!
# Create a dedicated token with minimal permissions
# GITHUB_TOKEN=ghp_your_token_here

# ============================================
# SECURITY REMINDERS
# ============================================
# 1. Copy this file to .env.local
# 2. Fill in your actual values in .env.local
# 3. NEVER commit .env.local to Git
# 4. Add .env.local to .gitignore (already done)
# 5. Rotate secrets every 90 days
# 6. Use different secrets for dev/staging/production
# 7. Read SECURITY.md for best practices